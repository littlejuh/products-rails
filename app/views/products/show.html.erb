<div class="p-6 max-w-2xl mx-auto bg-white rounded-lg shadow-md">
  <h1 class="text-2xl font-semibold mb-4"><%= @product.name %></h1>
  <p class="mb-2">Preço: <%= number_to_currency(@product.price) %></p>
  <p class="mb-2">Quantidade: <%= @product.quantity %></p>

  <div class="mt-4 flex gap-3">
    <%= link_to "Editar", edit_product_path(@product), class: "text-blue-600 hover:underline" %>
    <%= link_to "Voltar", products_path, class: "text-gray-600 hover:underline" %>
  </div>
</div>
