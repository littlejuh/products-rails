<%= turbo_frame_tag dom_id(product) do %>
  <div class="bg-white rounded-xl shadow p-4">
    <% if product.image_url.present? %>
      <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-full h-48 object-cover rounded-md mb-4" />
    <% end %>
    <h3 class="text-lg font-semibold mb-1"><%= product.name %></h3>
    <p class="text-gray-700">💰 R$ <%= number_to_currency(product.price, unit: '', separator: ',', delimiter: '.') %></p>
    <p class="text-gray-500 text-sm mb-3">Estoque: <%= product.quantity %> unidades</p>

    <div class="flex justify-between items-center">
      <%= link_to "Editar", edit_product_path(product), class: "text-blue-600 hover:underline" %>
      <%= link_to "Excluir", product_path(product),
          data: { turbo_method: :delete, confirm: "Tem certeza?" },
          class: "text-red-500 hover:underline" %>
    </div>
  </div>
<% end %>
