<body class="bg">
  <header class="card flex-between">
    <h1>📒 Todo List</h1>
    <%= link_to "New Note", new_note_path, data: { turbo_frame: "modal" }, class: "btn btn-primary" %>
  </header>

  <main class="container" id="notes">
    <%= turbo_frame_tag "notes" do %>
      <%= render @notes %>
    <% end %>
  </main>

  <footer class="card text-center">
    &copy; <%= Date.current.year %> Juliana’s Todo App
  </footer>

  <turbo-frame id="modal"></turbo-frame>
</body>